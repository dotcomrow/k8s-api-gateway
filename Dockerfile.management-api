# Build the trace context policy plugin
FROM maven:3.9.8-eclipse-temurin-17 AS trace-context-policy-build
WORKDIR /workspace/trace-context-policy
COPY trace-context-policy /workspace/trace-context-policy
RUN mvn -q -DskipTests package

# Gravitee.io Management API with YugabyteDB Support
FROM graviteeio/apim-management-api:4.9.10

ARG OTEL_LOGBACK_APPENDER_VERSION=1.33.0-alpha

# Switch to root for package installations
USER root

# Install additional tools and PostgreSQL client for YugabyteDB
RUN apk add --no-cache \
    postgresql-client \
    curl \
    wget \
    jq \
    netcat-openbsd

# Add enhanced PostgreSQL/YugabyteDB JDBC driver
RUN wget -q https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.4/postgresql-42.7.4.jar \
    -O /usr/local/lib/postgresql-42.7.4.jar
# Also copy the JDBC driver to the Gravitee lib directory for classpath loading
RUN cp /usr/local/lib/postgresql-42.7.4.jar /opt/graviteeio-management-api/lib/postgresql-42.7.4.jar

# Install OpenTelemetry Logback appender for log export (load from ext classpath).
RUN wget -q https://repo1.maven.org/maven2/io/opentelemetry/instrumentation/opentelemetry-logback-appender-1.0/${OTEL_LOGBACK_APPENDER_VERSION}/opentelemetry-logback-appender-1.0-${OTEL_LOGBACK_APPENDER_VERSION}.jar \
    -O /opt/graviteeio-management-api/lib/ext/opentelemetry-logback-appender-1.0-${OTEL_LOGBACK_APPENDER_VERSION}.jar \
    && chmod 0444 /opt/graviteeio-management-api/lib/ext/opentelemetry-logback-appender-1.0-${OTEL_LOGBACK_APPENDER_VERSION}.jar

# Copy custom configuration with YugabyteDB and Vault integration
COPY --chown=graviteeio:gravitee src/gravitee-config/management-api/gravitee.yml /opt/graviteeio-management-api/config/
# Install the trace context policy plugin (required for API import validation)
COPY --from=trace-context-policy-build /workspace/trace-context-policy/target/trace-context-policy-1.0.0-SNAPSHOT.zip /opt/graviteeio-management-api/plugins/

# Switch back to gravitee user (logs directory already exists with correct permissions)
USER graviteeio

# Expose management API port
EXPOSE 8083

# Enhanced health check for Kubernetes readiness/liveness probes
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
    CMD curl -f http://localhost:8083/management/platform || exit 1

# Set working directory
WORKDIR /opt/graviteeio-management-api

# Default command (can be overridden in Kubernetes)
CMD ["./bin/gravitee"]
