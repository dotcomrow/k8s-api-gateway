# Custom APISIX image with required packages
FROM apache/apisix:3.11.0-debian

USER root
RUN apt-get update -qq \
	&& apt-get install -y -qq openssl netcat-openbsd wget \
	&& wget -O /usr/local/bin/yq https://github.com/mikefarah/yq/releases/download/v4.40.5/yq_linux_amd64 \
	&& chmod +x /usr/local/bin/yq \
	&& rm -rf /var/lib/apt/lists/*
USER apisix

# Entrypoint and CMD are inherited from base image
