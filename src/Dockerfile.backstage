# Multi-stage Dockerfile for Backstage
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Install system dependencies for building
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git \
    curl \
    libc6-compat \
    pkgconfig \
    autoconf \
    automake \
    libtool \
    nasm \
    linux-headers \
    musl-dev \
    gcc \
    binutils-gold \
    vips-dev

# Set Node.js memory optimization for build - use full available memory
ENV NODE_OPTIONS="--max-old-space-size=14336"
ENV NODE_ENV=development
ENV npm_config_build_from_source=true
ENV PYTHON=/usr/bin/python3
ENV CC=gcc
ENV CXX=g++

# Install Backstage CLI globally
RUN npm install -g @backstage/create-app@latest --legacy-peer-deps

# Enable Corepack for proper Yarn version management
RUN corepack enable

# Create Backstage app
RUN echo "backstage-app" | npx @backstage/create-app@latest --skip-install || \
    npx @backstage/create-app@latest backstage-app --skip-install || \
    npx create-backstage-app@latest --name backstage-app --skip-install

# Copy the generated app structure
RUN cp -r backstage-app/* /app/ && rm -rf backstage-app

# Use Corepack to ensure correct Yarn version
RUN corepack install

# Initialize git repository early to prevent build warnings
RUN git config --global user.email "build@backstage.local" && \
    git config --global user.name "Build Process" && \
    git init . && \
    echo "node_modules/" > .gitignore && \
    echo "dist/" >> .gitignore && \
    git add . && \
    git commit -m "Initial build setup" || echo "Git setup complete"

# Fix workspace links in package.json files
RUN find /app -name "package.json" -type f -exec sed -i 's|"link:../app"|"file:../app"|g' {} \; && \
    find /app -name "package.json" -type f -exec sed -i 's|"link:|"file:|g' {} \;

# Install dependencies with full memory
RUN yarn install --network-timeout 300000 --ignore-engines || \
    yarn install --network-timeout 300000 --mode loose --ignore-engines || \
    (rm -f yarn.lock && yarn install --network-timeout 300000 --ignore-engines)

# Add missing dependencies that Backstage needs but aren't always installed
# Including pg client for YugabyteDB compatibility
RUN echo "🔧 Installing dependencies including pure JavaScript PostgreSQL client..." && \
    yarn add prop-types typescript @types/react @types/react-dom @types/node pg@8.8.0 --dev --ignore-engines && \
    echo "🔧 Removing pg-native to prevent native binding issues..." && \
    rm -rf node_modules/pg-native 2>/dev/null || true && \
    rm -rf */node_modules/pg-native 2>/dev/null || true && \
    find . -name "pg-native" -type d -exec rm -rf {} + 2>/dev/null || true && \
    echo "🔧 Patching pg library to force pure JavaScript mode..." && \
    if [ -f "node_modules/pg/lib/index.js" ]; then \
        cp node_modules/pg/lib/index.js node_modules/pg/lib/index.js.backup && \
        sed -i 's/var native = null/var native = null; \/\/ FORCED PURE JS MODE/g' node_modules/pg/lib/index.js && \
        sed -i '/require.*pg-native/d' node_modules/pg/lib/index.js && \
        echo "✅ pg library patched for pure JavaScript mode"; \
    fi && \
    echo "✅ Pure JavaScript PostgreSQL client configured"

# Build the backend - MUST succeed for production image
RUN if [ -d "packages/backend" ]; then \
        echo "Building backend..." && \
        # Regenerate yarn.lock if corrupted \
        (yarn install --ignore-engines 2>/dev/null || (rm -f yarn.lock && yarn install --ignore-engines)) && \
        # Try different build approaches in order of preference \
        (echo "Trying yarn build:backend..." && yarn build:backend --ignore-engines) || \
        (echo "Trying workspace backend build..." && cd packages/backend && yarn build --ignore-engines) || \
        (echo "Trying TypeScript compilation..." && cd packages/backend && yarn tsc --skipLibCheck) || \
        (echo "Installing TypeScript and trying..." && yarn add -W typescript@latest --dev --ignore-engines && cd packages/backend && yarn tsc --skipLibCheck) || \
        (echo "ERROR: All backend build attempts failed" && exit 1) && \
        echo "Backend build completed successfully"; \
    else \
        echo "ERROR: No backend package found" && exit 1; \
    fi

# Build the frontend if it exists - but don't fail the entire build if it fails
RUN if [ -d "packages/app" ]; then \
        echo "Building frontend..." && \
        # Install frontend-specific dependencies first \
        (cd packages/app && yarn add prop-types @types/react @types/react-dom --dev 2>/dev/null || true) && \
        # Try building frontend with various approaches \
        (cd packages/app && yarn build 2>/dev/null) || \
        (yarn build:app 2>/dev/null) || \
        (cd packages/app && npm run build 2>/dev/null) || \
        echo "Frontend build failed - continuing with backend-only build"; \
    else \
        echo "No frontend package found, skipping frontend build"; \
    fi

# Check and extract backend bundle if needed
RUN echo "🔍 Checking build output locations..." && \
    echo "📁 Backend dist directory:" && \
    ls -la packages/backend/dist/ 2>/dev/null || echo "No packages/backend/dist directory" && \
    if [ -f "packages/backend/dist/bundle.tar.gz" ]; then \
        echo "✅ Found backend bundle, extracting..." && \
        cd packages/backend/dist && \
        tar -xzf bundle.tar.gz && \
        echo "Extracted contents:" && \
        ls -la && \
        echo "✅ Backend bundle extracted successfully" && \
        cd /app; \
    elif [ -f "packages/backend/dist/index.js" ]; then \
        echo "✅ Found built backend index.js"; \
    elif [ -f "dist/packages/backend/index.js" ]; then \
        echo "✅ Found backend in workspace dist"; \
    elif [ -f "dist/index.js" ]; then \
        echo "✅ Found backend in root dist"; \
    else \
        echo "❌ ERROR: No backend build output found" && \
        echo "Available files in backend/dist:" && \
        find packages/backend/dist -type f 2>/dev/null | head -10 && \
        exit 1; \
    fi

# Clean up build dependencies and caches
RUN rm -rf /tmp/* ~/.npm ~/.cache /var/cache/apk/* && \
    yarn cache clean 2>/dev/null || true

# Production stage - fully built and ready to run
FROM node:20-alpine AS runtime

# Install only minimal runtime dependencies including socat for TCP proxy
RUN apk add --no-cache git curl socat

# Enable corepack for proper yarn version
RUN corepack enable

# Set runtime environment
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=14336"

# Create app user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S backstage -u 1001

# Set working directory
WORKDIR /app

# Copy ONLY the built application from builder stage
COPY --from=builder --chown=backstage:nodejs /app /app

# Install production dependencies as root to avoid permission issues
RUN corepack install && \
    yarn install --production --frozen-lockfile --network-timeout 300000 || \
    npm install --only=production --legacy-peer-deps --no-audit --no-fund

# Verify the build is complete and ready in production image (as root for git setup)
RUN echo "Verifying production build completeness..." && \
    echo "🔍 Backend dist contents:" && \
    ls -la packages/backend/dist/ 2>/dev/null || echo "No backend dist directory" && \
    if [ -f "packages/backend/dist/index.js" ] || [ -f "dist/packages/backend/index.js" ] || [ -f "dist/index.js" ] || [ -f "packages/backend/dist/bundle.tar.gz" ]; then \
        echo "✅ Backend build found and ready for production"; \
    else \
        echo "❌ ERROR: No built backend found in production image!" && \
        echo "Available files:" && \
        find . -name "*.js" -o -name "*.tar.gz" | grep -E "(backend|dist)" | head -10 && \
        exit 1; \
    fi

# Pre-configure git for runtime as backstage user  
RUN git config --global user.email "backstage@k8s-api-gateway.local" && \
    git config --global user.name "Backstage Container" && \
    git config --global init.defaultBranch main

# Initialize git repository (pre-setup for runtime) with proper permissions
RUN git init . 2>/dev/null || echo "Git init skipped" && \
    echo "node_modules/" > .gitignore 2>/dev/null || true && \
    echo "dist/" >> .gitignore 2>/dev/null || true && \
    echo "*.log" >> .gitignore 2>/dev/null || true && \
    git add .gitignore package.json yarn.lock 2>/dev/null || true && \
    git commit -m "Production container ready" 2>/dev/null || echo "Git setup complete" && \
    chown -R backstage:nodejs /app 2>/dev/null || true

# Switch to backstage user for runtime
USER backstage

# Expose port
EXPOSE 7007

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:7007/api/catalog/health || exit 1

# Simple start command - everything is pre-built
CMD ["sh", "-c", "\
    echo '🚀 Starting pre-built Backstage application...' && \
    echo '📊 Container memory info:' && \
    free -h 2>/dev/null || echo 'Memory info not available' && \
    echo '🔍 Searching for built backend...' && \
    if [ -f 'packages/backend/dist/bundle.tar.gz' ]; then \
        echo '📦 Extracting backend bundle if needed...' && \
        cd packages/backend/dist && \
        if [ ! -f 'index.js' ]; then \
            echo '🔍 Examining bundle contents before extraction:' && \
            tar -tzf bundle.tar.gz | head -10 && \
            echo '📦 Extracting bundle...' && \
            tar -xzf bundle.tar.gz && \
            echo '📁 Contents after extraction:' && \
            ls -la && \
            echo '🔍 Looking for backend entry points recursively:' && \
            find . -name 'index*.js' -type f 2>/dev/null || echo 'No backend entry points found'; \
        fi && \
        BACKEND_JS='' && \
        if [ -f 'index.js' ]; then \
            BACKEND_JS='index.js'; \
        elif [ -f 'index.cjs.js' ]; then \
            BACKEND_JS='index.cjs.js'; \
        elif [ -f 'packages/backend/dist/index.js' ]; then \
            BACKEND_JS='packages/backend/dist/index.js'; \
        elif [ -f 'packages/backend/dist/index.cjs.js' ]; then \
            BACKEND_JS='packages/backend/dist/index.cjs.js'; \
        elif [ -f 'dist/index.js' ]; then \
            BACKEND_JS='dist/index.js'; \
        elif [ -f 'dist/index.cjs.js' ]; then \
            BACKEND_JS='dist/index.cjs.js'; \
        elif [ -f 'bundle/index.js' ]; then \
            BACKEND_JS='bundle/index.js'; \
        elif [ -f 'bundle/index.cjs.js' ]; then \
            BACKEND_JS='bundle/index.cjs.js'; \
        else \
            BACKEND_JS=$(find . -name 'index.*.js' -type f | head -1); \
        fi && \
        if [ -n \"$BACKEND_JS\" ] && [ -f \"$BACKEND_JS\" ]; then \
            echo \"✅ Starting backend from extracted bundle: $BACKEND_JS\" && \
            echo '🔧 Setting up config file...' && \
            if [ -f '/app/app-config.yaml' ]; then \
                echo 'Source config exists at /app/app-config.yaml' && \
                mkdir -p /app/packages/backend/dist && \
                cp /app/app-config.yaml /app/packages/backend/dist/app-config.yaml && \
                echo 'Config file copied to /app/packages/backend/dist/app-config.yaml' && \
                ls -la /app/packages/backend/dist/app-config.yaml || echo 'Config copy verification failed'; \
            else \
                echo 'Source config file /app/app-config.yaml not found'; \
            fi && \
            exec node \"$BACKEND_JS\"; \
        else \
            echo '❌ Bundle extraction failed - no backend entry point found anywhere' && \
            echo '📁 Complete directory structure:' && \
            find . -type f | head -20 && \
            exit 1; \
        fi; \
    elif [ -f 'packages/backend/dist/index.js' ]; then \
        echo '✅ Starting pre-built backend from packages/backend/dist/index.js' && \
        echo '🔧 Setting up config file...' && \
        if [ -f '/app/app-config.yaml' ]; then \
            echo 'Source config exists at /app/app-config.yaml' && \
            mkdir -p /app/packages/backend/dist && \
            cp /app/app-config.yaml /app/packages/backend/dist/app-config.yaml && \
            echo 'Config file copied to /app/packages/backend/dist/app-config.yaml' && \
            ls -la /app/packages/backend/dist/app-config.yaml || echo 'Config copy verification failed'; \
        else \
            echo 'Source config file /app/app-config.yaml not found'; \
        fi && \
        exec node packages/backend/dist/index.js; \
    elif [ -f 'packages/backend/dist/index.cjs.js' ]; then \
        echo '✅ Starting pre-built backend from packages/backend/dist/index.cjs.js' && \
        echo '🔧 Setting up config file...' && \
        if [ -f '/app/app-config.yaml' ]; then \
            echo 'Source config exists at /app/app-config.yaml' && \
            mkdir -p /app/packages/backend/dist && \
            cp /app/app-config.yaml /app/packages/backend/dist/app-config.yaml && \
            echo 'Config file copied to /app/packages/backend/dist/app-config.yaml' && \
            ls -la /app/packages/backend/dist/app-config.yaml || echo 'Config copy verification failed'; \
        else \
            echo 'Source config file /app/app-config.yaml not found'; \
        fi && \
        exec node packages/backend/dist/index.cjs.js; \
    elif [ -f 'dist/packages/backend/index.js' ]; then \
        echo '✅ Starting pre-built backend from dist/packages/backend/index.js' && \
        exec node dist/packages/backend/index.js; \
    elif [ -f 'dist/packages/backend/index.cjs.js' ]; then \
        echo '✅ Starting pre-built backend from dist/packages/backend/index.cjs.js' && \
        exec node dist/packages/backend/index.cjs.js; \
    elif [ -f 'dist/index.js' ]; then \
        echo '✅ Starting pre-built backend from dist/index.js' && \
        exec node dist/index.js; \
    elif [ -f 'dist/index.cjs.js' ]; then \
        echo '✅ Starting pre-built backend from dist/index.cjs.js' && \
        exec node dist/index.cjs.js; \
    else \
        echo '❌ ERROR: No pre-built backend found!' && \
        echo '📁 Backend dist contents:' && \
        ls -la packages/backend/dist/ 2>/dev/null || echo 'No backend dist' && \
        echo '📄 Available files:' && \
        find . -name '*.js' -o -name '*.tar.gz' | head -10 && \
        exit 1; \
    fi"]