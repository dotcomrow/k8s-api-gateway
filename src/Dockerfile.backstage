# Multi-stage Dockerfile for Backstage
FROM node:18-alpine AS builder

# Set working directory
WORKDIR /app

# Install system dependencies for building
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git \
    curl \
    libc6-compat \
    pkgconfig \
    autoconf \
    automake \
    libtool \
    nasm \
    linux-headers \
    musl-dev \
    gcc \
    binutils-gold \
    vips-dev

# Set Node.js memory optimization for build - use full available memory
ENV NODE_OPTIONS="--max-old-space-size=14336"
ENV NODE_ENV=development
ENV npm_config_build_from_source=true
ENV PYTHON=/usr/bin/python3
ENV CC=gcc
ENV CXX=g++

# Install Backstage CLI globally
RUN npm install -g @backstage/create-app@latest --legacy-peer-deps

# Enable Corepack for proper Yarn version management
RUN corepack enable

# Create Backstage app
RUN echo "backstage-app" | npx @backstage/create-app@latest --skip-install || \
    npx @backstage/create-app@latest backstage-app --skip-install || \
    npx create-backstage-app@latest --name backstage-app --skip-install

# Copy the generated app structure
RUN cp -r backstage-app/* /app/ && rm -rf backstage-app

# Use Corepack to ensure correct Yarn version
RUN corepack install

# Fix workspace links in package.json files
RUN find /app -name "package.json" -type f -exec sed -i 's|"link:../app"|"file:../app"|g' {} \; && \
    find /app -name "package.json" -type f -exec sed -i 's|"link:|"file:|g' {} \;

# Install dependencies with full memory
RUN yarn install --network-timeout 300000 || \
    yarn install --network-timeout 300000 --mode loose || \
    npm install --legacy-peer-deps --no-audit --no-fund

# Build the backend - MUST succeed for production image
RUN if [ -d "packages/backend" ]; then \
        echo "Building backend..." && \
        (yarn build:backend || \
        (cd packages/backend && yarn build) || \
        (cd packages/backend && yarn tsc) || \
        (cd packages/backend && npx tsc)) && \
        echo "Backend build completed successfully"; \
    else \
        echo "ERROR: No backend package found" && exit 1; \
    fi

# Build the frontend if it exists
RUN if [ -d "packages/app" ]; then \
        echo "Building frontend..." && \
        (yarn build:frontend || \
        (cd packages/app && yarn build) || \
        echo "Frontend build completed with warnings"); \
    fi

# Check and extract backend bundle if needed
RUN echo "🔍 Checking build output locations..." && \
    echo "📁 Backend dist directory:" && \
    ls -la packages/backend/dist/ 2>/dev/null || echo "No packages/backend/dist directory" && \
    if [ -f "packages/backend/dist/bundle.tar.gz" ]; then \
        echo "✅ Found backend bundle, extracting..." && \
        cd packages/backend/dist && \
        tar -xzf bundle.tar.gz && \
        echo "Extracted contents:" && \
        ls -la && \
        echo "✅ Backend bundle extracted successfully" && \
        cd /app; \
    elif [ -f "packages/backend/dist/index.js" ]; then \
        echo "✅ Found built backend index.js"; \
    elif [ -f "dist/packages/backend/index.js" ]; then \
        echo "✅ Found backend in workspace dist"; \
    elif [ -f "dist/index.js" ]; then \
        echo "✅ Found backend in root dist"; \
    else \
        echo "❌ ERROR: No backend build output found" && \
        echo "Available files in backend/dist:" && \
        find packages/backend/dist -type f 2>/dev/null | head -10 && \
        exit 1; \
    fi

# Clean up build dependencies and caches
RUN rm -rf /tmp/* ~/.npm ~/.cache /var/cache/apk/* && \
    yarn cache clean 2>/dev/null || true

# Production stage - fully built and ready to run
FROM node:18-alpine AS runtime

# Install only minimal runtime dependencies
RUN apk add --no-cache git curl

# Enable corepack for proper yarn version
RUN corepack enable

# Set runtime environment
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=14336"

# Create app user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S backstage -u 1001

# Set working directory
WORKDIR /app

# Copy ONLY the built application from builder stage
COPY --from=builder --chown=backstage:nodejs /app /app

# Install production dependencies as root to avoid permission issues
RUN corepack install && \
    yarn install --production --frozen-lockfile --network-timeout 300000 || \
    npm install --only=production --legacy-peer-deps --no-audit --no-fund

# Switch to backstage user for runtime
USER backstage

# Verify the build is complete and ready in production image
RUN echo "Verifying production build completeness..." && \
    echo "🔍 Backend dist contents:" && \
    ls -la packages/backend/dist/ 2>/dev/null || echo "No backend dist directory" && \
    if [ -f "packages/backend/dist/index.js" ] || [ -f "dist/packages/backend/index.js" ] || [ -f "dist/index.js" ] || [ -f "packages/backend/dist/bundle.tar.gz" ]; then \
        echo "✅ Backend build found and ready for production"; \
    else \
        echo "❌ ERROR: No built backend found in production image!" && \
        echo "Available files:" && \
        find . -name "*.js" -o -name "*.tar.gz" | grep -E "(backend|dist)" | head -10 && \
        exit 1; \
    fi

# Pre-configure git for runtime
RUN git config --global user.email "backstage@k8s-api-gateway.local" && \
    git config --global user.name "Backstage Container" && \
    git config --global init.defaultBranch main && \
    git config --global init.defaultBranch main

# Initialize git repository (pre-setup for runtime)
RUN git init . && \
    echo "node_modules/" > .gitignore && \
    echo "dist/" >> .gitignore && \
    echo "*.log" >> .gitignore && \
    git add .gitignore package.json yarn.lock 2>/dev/null || true && \
    git commit -m "Production container ready" 2>/dev/null || echo "Git setup complete"

# Expose port
EXPOSE 7007

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:7007/api/catalog/health || exit 1

# Simple start command - everything is pre-built
CMD ["sh", "-c", "\
    echo '🚀 Starting pre-built Backstage application...' && \
    echo '📊 Container memory info:' && \
    free -h 2>/dev/null || echo 'Memory info not available' && \
    echo '🔍 Searching for built backend...' && \
    if [ -f 'packages/backend/dist/bundle.tar.gz' ]; then \
        echo '📦 Extracting backend bundle if needed...' && \
        cd packages/backend/dist && \
        if [ ! -f 'index.js' ]; then \
            echo '🔍 Examining bundle contents before extraction:' && \
            tar -tzf bundle.tar.gz | head -10 && \
            echo '📦 Extracting bundle...' && \
            tar -xzf bundle.tar.gz && \
            echo '📁 Contents after extraction:' && \
            ls -la && \
            echo '🔍 Looking for index.js files recursively:' && \
            find . -name 'index.js' -type f 2>/dev/null || echo 'No index.js found'; \
        fi && \
        BACKEND_JS='' && \
        if [ -f 'index.js' ]; then \
            BACKEND_JS='index.js'; \
        elif [ -f 'dist/index.js' ]; then \
            BACKEND_JS='dist/index.js'; \
        elif [ -f 'bundle/index.js' ]; then \
            BACKEND_JS='bundle/index.js'; \
        else \
            BACKEND_JS=$(find . -name 'index.js' -type f | head -1); \
        fi && \
        if [ -n \"$BACKEND_JS\" ] && [ -f \"$BACKEND_JS\" ]; then \
            echo \"✅ Starting backend from extracted bundle: $BACKEND_JS\" && \
            exec node \"$BACKEND_JS\"; \
        else \
            echo '❌ Bundle extraction failed - no index.js found anywhere' && \
            echo '📁 Complete directory structure:' && \
            find . -type f | head -20 && \
            exit 1; \
        fi; \
    elif [ -f 'packages/backend/dist/index.js' ]; then \
        echo '✅ Starting pre-built backend from packages/backend/dist/index.js' && \
        exec node packages/backend/dist/index.js; \
    elif [ -f 'dist/packages/backend/index.js' ]; then \
        echo '✅ Starting pre-built backend from dist/packages/backend/index.js' && \
        exec node dist/packages/backend/index.js; \
    elif [ -f 'dist/index.js' ]; then \
        echo '✅ Starting pre-built backend from dist/index.js' && \
        exec node dist/index.js; \
    else \
        echo '❌ ERROR: No pre-built backend found!' && \
        echo '📁 Backend dist contents:' && \
        ls -la packages/backend/dist/ 2>/dev/null || echo 'No backend dist' && \
        echo '📄 Available files:' && \
        find . -name '*.js' -o -name '*.tar.gz' | head -10 && \
        exit 1; \
    fi"]