# Gravitee.io Gateway with Enhanced Monitoring
FROM graviteeio/apim-gateway:4.6.0

# Switch to root for package installations  
USER root

# Install monitoring and debugging tools
RUN apk add --no-cache \
    curl \
    netcat-openbsd \
    jq \
    tcpdump

RUN wget -q https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.4/postgresql-42.7.4.jar \
    -O /opt/graviteeio-gateway/lib/postgresql-42.7.4.jar
# Copy custom gateway configuration for Kubernetes and APISIX integration
COPY --chown=graviteeio:gravitee src/gravitee-config/gateway/gravitee.yml /opt/graviteeio-gateway/config/

# Switch back to gravitee user (logs directory already exists with correct permissions)
USER graviteeio

# Expose gateway port
EXPOSE 8082

# Enhanced health check for Kubernetes readiness/liveness probes  
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8082/_node/health || exit 1

# Set working directory
WORKDIR /opt/graviteeio-gateway

# Default command (can be overridden in Kubernetes)
CMD ["./bin/gravitee"]