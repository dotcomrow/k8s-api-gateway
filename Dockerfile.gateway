# Build the trace context policy plugin
FROM maven:3.9.8-eclipse-temurin-17 AS trace-context-policy-build
WORKDIR /workspace/trace-context-policy
COPY trace-context-policy /workspace/trace-context-policy
RUN mvn -q -DskipTests package

# Gravitee.io Gateway with Enhanced Monitoring
FROM graviteeio/apim-gateway:4.9.10

ARG OTEL_AGENT_VERSION=1.33.0
ARG OTEL_LOGBACK_APPENDER_VERSION=1.33.0-alpha

# Switch to root for package installations  
USER root

# Install monitoring and debugging tools
RUN apk add --no-cache \
    curl \
    netcat-openbsd \
    jq \
    tcpdump

RUN wget -q https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.4/postgresql-42.7.4.jar \
    -O /usr/local/lib/postgresql-42.7.4.jar
# Install OpenTelemetry Java agent for gateway tracing.
RUN mkdir -p /opt/otel \
    && wget -q https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_AGENT_VERSION}/opentelemetry-javaagent.jar \
      -O /opt/otel/opentelemetry-javaagent.jar \
    && chmod 0444 /opt/otel/opentelemetry-javaagent.jar

# Install OpenTelemetry Logback appender for log export
RUN wget -q https://repo1.maven.org/maven2/io/opentelemetry/instrumentation/opentelemetry-logback-appender-1.0/${OTEL_LOGBACK_APPENDER_VERSION}/opentelemetry-logback-appender-1.0-${OTEL_LOGBACK_APPENDER_VERSION}.jar \
    -O /opt/graviteeio-gateway/lib/opentelemetry-logback-appender-1.0-${OTEL_LOGBACK_APPENDER_VERSION}.jar \
    && chmod 0444 /opt/graviteeio-gateway/lib/opentelemetry-logback-appender-1.0-${OTEL_LOGBACK_APPENDER_VERSION}.jar

# Ensure Logback can load the OTEL appender during early bootstrap.
RUN cat > /tmp/patch-gravitee-classpath.sh <<'EOF'
#!/bin/sh
set -e
target="/opt/graviteeio-gateway/bin/gravitee"
tmp="$(mktemp)"
awk '
  {print}
  /^GRAVITEE_BOOT_CLASSPATH=/ {
    print "OTEL_LOGBACK_APPENDER_JAR=$(ls -1 \"$GRAVITEE_HOME\"/lib/opentelemetry-logback-appender-1.0-*.jar 2>/dev/null | head -n 1)"
    print "if [ -n \"$OTEL_LOGBACK_APPENDER_JAR\" ]; then"
    print "  GRAVITEE_BOOT_CLASSPATH=\"${GRAVITEE_BOOT_CLASSPATH}:${OTEL_LOGBACK_APPENDER_JAR}\""
    print "fi"
  }
' "$target" > "$tmp"
mv "$tmp" "$target"
chmod 0755 "$target"
EOF
RUN sh /tmp/patch-gravitee-classpath.sh && rm /tmp/patch-gravitee-classpath.sh
# Also copy the JDBC driver to the Gravitee lib directory for classpath loading
RUN cp /usr/local/lib/postgresql-42.7.4.jar /opt/graviteeio-gateway/lib/postgresql-42.7.4.jar
# Copy custom gateway configuration for Kubernetes and APISIX integration
COPY --chown=graviteeio:gravitee src/gravitee-config/gateway/gravitee.yml /opt/graviteeio-gateway/config/
# Install the trace context policy plugin
COPY --from=trace-context-policy-build /workspace/trace-context-policy/target/trace-context-policy-1.0.0-SNAPSHOT.zip /opt/graviteeio-gateway/plugins/

# Switch back to gravitee user (logs directory already exists with correct permissions)
USER graviteeio

# Expose gateway port
EXPOSE 8082

# Enhanced health check for Kubernetes readiness/liveness probes  
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8082/_node/health || exit 1

# Set working directory
WORKDIR /opt/graviteeio-gateway

# Default command (can be overridden in Kubernetes)
CMD ["./bin/gravitee"]
